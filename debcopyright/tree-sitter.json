{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "debcopyright",
      "camelcase": "DebCopyright",
      "title": "Debian Copyright",
      "scope": "source.debcopyright",
      "file-types": [
        "debcopyright"
      ],
      "injection-regex": "^debcopyright$",
      "class-name": "TreeSitterDebcopyright"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "debian/copyright file",
    "authors": [
      {
        "name": "Grayson Wolf",
        "email": "grayson.wolf@canonical.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-debcopyright",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}